{
  "private": true,
  "name": "viite",
  "version": "0.0.1",
  "type": "module",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "less": "^4.9.1",
    "mocha": "^12.0.3",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "backbone": "1.6.0",
    "interactjs": "1.10.27",
    "jquery": "3.7.1",
    "lodash": "4.17.23",
    "moment": "2.30.1",
    "ol": "9.2.4",
    "pikaday": "1.8.2",
    "proj4": "2.11.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "prepare:public": "node scripts/prepare-public-assets.mjs",
    "dev": "npm run prepare:public && vite --host 127.0.0.1 --port 9003 --strictPort",
    "lint": "eslint eslint.config.cjs .eslintrc.cjs vite.config.mjs \"scripts/**/*.mjs\" \"viite-UI/src/**/*.js\" \"viite-UI/test/**/*.js\"",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test": "npm run lint && npm run test:unit",
    "test:watch": "node --watch scripts/run-unit-tests.mjs",
    "build": "npm test && npm run prepare:public && vite build",
    "deploy": "npm run build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
  }
}
